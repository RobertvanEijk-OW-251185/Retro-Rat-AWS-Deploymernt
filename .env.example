NODE_ENV=development
MONGO_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
SITE_URL=http://localhost:5173

# Needed by server-side Cloudinary uploads. Keep the API secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
